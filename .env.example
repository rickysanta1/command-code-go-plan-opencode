# Copy this file to .env and set your key.
COMMANDCODE_API_KEY=user_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional. Default is 8787.
PORT=8787
# Optional. CLI version sent upstream. Default is 1.79.2.
CMD_VERSION=1.79.2
# Optional. Max ms to wait for upstream response headers. Default is 60000.
UPSTREAM_TIMEOUT=60000
# Optional. Max request body size in bytes. Default is 20971520 (20 MB).
MAX_BODY_BYTES=20971520
